# AEGIS defaults are intentionally offline and keyless.
LLM_PROVIDER=none
LLM_MODEL=fixture
LLM_API_KEY=
FRONTEND_ORIGIN=http://localhost:3000
FIXTURE_ONLY=1
FAKE_LLM=1
AEGIS_LIVE_ENABLED=0
AEGIS_LIVE_POLL_INTERVAL_SECONDS=30
AEGIS_LIVE_MAX_POLLS=3
AEGIS_TRACE_INTERVAL_SECONDS=2
USGS_FEED_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_day.geojson

# Set this when the Next.js dev server should read from a separate FastAPI host.
NEXT_PUBLIC_API_BASE=http://localhost:8000
