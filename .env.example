# AEGIS Level 0 defaults are intentionally offline and keyless.
LLM_PROVIDER=none
LLM_MODEL=fixture
LLM_API_KEY=
FRONTEND_ORIGIN=http://localhost:3000
FIXTURE_ONLY=1
FAKE_LLM=1

# Set this when the Next.js dev server should read from a separate FastAPI host.
NEXT_PUBLIC_API_BASE=http://localhost:8000
